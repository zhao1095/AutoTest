<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.course.model">
    <!--登录接口sql-->
    <select id="loginCase" parameterType="com.course.model.LoginCase" resultType="com.course.model.LoginCase">
      select userName,password,expected from logincase
        where userName = #{userName}
    </select>
    <!--获取用户信息-->
    <select id="getUserInfoCase"  parameterType="Integer" resultType="Integer" >
        select  * from getuserinfocase where id = #{id};
    </select>
    <!--添加用户信息-->
    <select id="addUserCase" parameterType="com.course.model.AddUserCase" resultType="com.course.model.User">
        select  * from user where
        userName = #{userName} and
        password = #{password} and
        sex =#{sex} and
        age = #{age} and
        permission = #{permission} and
        isDelete = #{isDelete}
    </select>
     <!--获取用户信息-->
    <select id="getUserInfo1Case" parameterType="Integer" resultType="com.course.model.GetUserInfoCase">
        select  * from  getuserinfocase where
        id= #{userId}
    </select>
    <!--获取用户列表-->
    <select id="getUserListCase" parameterType="com.course.model.GetUserListCase" resultType="com.course.model.User">
        select  * from user
        <trim prefix="where" prefixOverrides="and">
            <if test=" null != userName and '' != userName">
            and userName = #{userName}
            </if>
            <if test=" null != sex and '' != sex">
                and sex = #{sex}
            </if>
            <if test=" null != age and '' != age">
                and age = #{age}
            </if>

        </trim>
         ;
    </select>

    <!--获取更新之后的数据-->
    <select id="getUserInfoAndUpdate" parameterType="com.course.model.UpdateUserInfoCase" resultType="com.course.model.User">
        select  * from  user
        <trim prefix="where" prefixOverrides="and">
            <if test=" null != userName and '' != userName">
                and userName = #{userName}
            </if>
            <if test=" null != sex and '' != sex">
                and sex = #{sex}
            </if>
            <if test=" null != age and '' != age">
                and age = #{age}
            </if>
            <if test=" null != isDelete and '' != isDelete">
                and isDelete = #{isDelete}
            </if>
        </trim>
        AND  id = #{userId}
    </select>

</mapper>